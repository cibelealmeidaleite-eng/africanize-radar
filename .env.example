# ─────────────────────────────────────────────────────────────
# FRONTEND (exposto ao navegador — use apenas chaves públicas/anon)
# Prefixo VITE_ é obrigatório para o Vite expor a variável ao browser.
# ─────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica-aqui

# ─────────────────────────────────────────────────────────────
# BACKEND (Netlify Functions — NUNCA exponha estas ao frontend)
# ─────────────────────────────────────────────────────────────

# Mesma URL do projeto Supabase acima
SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave de SERVIÇO (service_role) do Supabase — Settings > API > service_role.
# Tem acesso total ao banco (ignora Row Level Security). Usada só nas
# Netlify Functions, nunca no bundle do frontend.
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role-aqui

# Chave da API da Anthropic — console.anthropic.com > API Keys
ANTHROPIC_API_KEY=sk-ant-...

# Opcional: sobrescreve o modelo padrão usado na curadoria (claude-sonnet-5).
# Consulte a documentação da Anthropic para o identificador de modelo mais
# recente disponível na sua conta antes de trocar este valor.
# ANTHROPIC_MODEL=claude-sonnet-5
